{
  "name": "jogpad",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "pnpm --filter @jogpad/desktop dev",
    "build": "pnpm --filter @jogpad/desktop build",
    "with-secrets": "varlock run",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc -b",
    "repojj:check": "repojj check",
    "repojj:check:fix": "repojj check --fix",
    "repojj:postfix": "biome check --write .",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@varlock/1password-plugin": "catalog:",
    "lefthook": "catalog:",
    "repojj": "catalog:",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "license": "MIT"
}
