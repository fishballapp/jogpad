# Signing credentials for local release builds, loaded from a 1Password
# Environment by id. Safe to commit: it names the Environment, never a value.
# Resolves through the 1Password desktop app, so nothing is kept on disk.
#
#   pnpm with-secrets -- pnpm --filter @jogpad/desktop build --bundles app
#
# CI does not read this file. release.yml takes the same names from the
# repository's GitHub secrets.
#
# @defaultRequired=true
# @defaultSensitive=true
# @plugin(@varlock/1password-plugin)
# @initOp(allowAppAuth=true)
# @setValuesBulk(opLoadEnvironment(ldirecmyxwkkxycped3ofv3r2i))
# ---

# The Developer ID identity codesign looks up in the login keychain.
# @sensitive=false
APPLE_SIGNING_IDENTITY=

# Signs the updater archive. Lose it and no installed app can update again.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
