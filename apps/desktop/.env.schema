# Signing credentials, loaded from three baymutt environments. Safe to commit:
# it names the environments, never a value. The team's Developer ID certificate
# and App Store Connect key live once each, in the environments every Mac app
# the team signs reads; what is JogPad's alone lives in its own.
#
# Loading it needs a key that reads all three, even for a local signed build.
# A CLI login holds none, so ask the owner for one, then name its file:
#
#   baymutt ask access --read fishball-ltd/apple/developer-id \
#     --read fishball-ltd/apple/app-store-connect --read fishball-ltd/jogpad/release \
#     --reason "<why>" --expires 1h
#   baymutt ask wait <id>          # approved: prints the key file's path
#   BAYMUTT_KEY_FILE=<path> pnpm -F @jogpad/desktop with-secrets -- pnpm bundle --bundles app
#
# `with-secrets` leaves out the #release items, so a local build is signed with
# the certificate from here but not notarized. Nothing is cached.
#
# cd.yml resolves all of them with the key in BAYMUTT_KEY, and hands the Apple
# ones to Tauri under the names it reads.
#
# @defaultRequired=true
# @defaultSensitive=true
# @plugin(@baymutt/varlock-plugin)
# @initBaymutt(key=$BAYMUTT_KEY)
# @setValuesBulk(baymuttLoad("fishball-ltd/apple/developer-id"))
# @setValuesBulk(baymuttLoad("fishball-ltd/apple/app-store-connect"))
# @setValuesBulk(baymuttLoad("fishball-ltd/jogpad/release"))
# ---

# A key that reads the three environments above, when it is handed over as a
# value (CI). Unset where BAYMUTT_KEY_FILE names the key file `baymutt ask wait`
# printed.
# @required=false
BAYMUTT_KEY=

# The Developer ID identity codesign signs with.
# @sensitive=false
APPLE_SIGNING_IDENTITY=

# Signs the updater archive. Lose it and no installed app can update again.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# The Developer ID certificate as a base64 .p12, and its password. Tauri
# imports it into a throwaway keychain for the build alone, in CI and locally
# (bundle.sh); no keychain keeps a copy.
MAC_NATIVE_APP_APPLE_CERTIFICATE=
MAC_NATIVE_APP_APPLE_CERTIFICATE_PASSWORD=
# @tag(release) @sensitive=false
APPLE_TEAM_ID=

# Notarization, through an App Store Connect API key. The .p8 is base64 on one
# line.
# @tag(release) @sensitive=false
ASC_KEY_ID=
# @tag(release) @sensitive=false
ASC_ISSUER_ID=
# @tag(release)
ASC_API_KEY_P8_BASE64=
