# Signing credentials, loaded from two 1Password Environments by id. Safe to
# commit: it names the Environments, never a value. The team's Developer ID
# certificate and App Store Connect key live once, in the Environment every
# app the team signs reads; what is JogPad's alone lives in its own.
#
# Locally they resolve through the 1Password desktop app, so nothing is kept
# on disk. `with-secrets` leaves out the #release items, so a local build is
# signed with the keychain's identity but not notarized:
#
#   pnpm -F @jogpad/desktop with-secrets -- pnpm bundle --bundles app
#
# cd.yml resolves all of them with the service-account token in OP_TOKEN, and
# hands the Apple ones to Tauri under the names it reads.
#
# @defaultRequired=true
# @defaultSensitive=true
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_TOKEN, allowAppAuth=true, cacheTtl=1d)
# @setValuesBulk(opLoadEnvironment(ykljsst56zqg63ohl63nwaxu4q))
# @setValuesBulk(opLoadEnvironment(ldirecmyxwkkxycped3ofv3r2i))
# ---

# 1Password service-account token, read-only on the two Environments above.
# Set in CI only; local runs use the desktop app.
# @type=opServiceAccountToken @required=false
OP_TOKEN=

# The Developer ID identity codesign signs with.
# @sensitive=false
APPLE_SIGNING_IDENTITY=

# Signs the updater archive. Lose it and no installed app can update again.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# The Developer ID certificate as a base64 .p12. Tauri imports it into a
# throwaway keychain; locally it is already in the login keychain.
# @tag(release)
MAC_NATIVE_APP_APPLE_CERTIFICATE=
# @tag(release)
MAC_NATIVE_APP_APPLE_CERTIFICATE_PASSWORD=
# @tag(release) @sensitive=false
APPLE_TEAM_ID=

# Notarization, through an App Store Connect API key. The .p8 is base64:
# 1Password Environment values are single-line, and a raw PEM loads as its
# first line only.
# @tag(release) @sensitive=false
ASC_KEY_ID=
# @tag(release) @sensitive=false
ASC_ISSUER_ID=
# @tag(release)
ASC_API_KEY_P8_BASE64=
